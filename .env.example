# =====================================================================
#  Westaf Records — configuration de l'API (copier en .env et compléter)
#  Ne jamais committer le fichier .env
#
#  Le .env déjà en place sur Hostinger (ancienne version : DB_*, PAYTECH_*, FRONTEND_URL,
#  ADMIN_LOGIN, ADMIN_PASSWORD, ADMIN_TOKEN_SECRET, CORS_ORIGINS) SUFFIT : aucune variable
#  n'est à ajouter. Toutes les autres lignes ci-dessous sont FACULTATIVES.
# =====================================================================

PORT=5000
NODE_ENV=production
TZ=Africa/Dakar

# URL publique du site (liens envoyés par e-mail / WhatsApp, retours PayTech)
FRONTEND_URL=https://westafrecords.com
# URL publique de cette API (sert à construire l'URL IPN PayTech si PAYTECH_IPN_URL est vide)
PUBLIC_API_URL=https://forestgreen-mole-128636.hostingersite.com
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=https://westafrecords.com,https://www.westafrecords.com,https://harmonious-florentine-0eff6a.netlify.app

# --- Sécurité (facultatif) ---
# Sans JWT_SECRET (ou ADMIN_TOKEN_SECRET de 32 caractères et plus), le serveur génère une clé
# au premier démarrage et la conserve en base (table app_secrets).
JWT_SECRET=
JWT_TTL=7d
STAFF_JWT_TTL=12h

# --- MySQL (Hostinger) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Migrations appliquées automatiquement au démarrage (true par défaut)
AUTO_MIGRATE=true

# --- Comptes (facultatif) ---
# Le super admin et l'admin (Jeuss) sont créés par la migration 012 (mot de passe à changer à la
# 1re connexion). Ces variables ne servent qu'à créer un compte supplémentaire si aucun n'existe.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Jeuss

# --- PayTech ---
PAYTECH_BASE_URL=https://paytech.sn/api
# Clés PayTech : à renseigner uniquement dans le .env du serveur (jamais dans Git)
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=prod
# URL publique de l'IPN (POST) appelée par PayTech après paiement
PAYTECH_IPN_URL=https://forestgreen-mole-128636.hostingersite.com/ipn
PAYTECH_REFUND_NOTIF_URL=https://westafrecords.com/api/refund-notification
CURRENCY=XOF

# --- Google OAuth (connexion « Continuer avec Google ») ---
# ID client OAuth « Application Web » (console.cloud.google.com > API et services > Identifiants)
GOOGLE_CLIENT_ID=

# --- E-mails (mot de passe oublié, confirmations) — SMTP Hostinger par exemple ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Jeton choisi librement, à saisir dans Meta lors de la configuration du webhook
WHATSAPP_VERIFY_TOKEN=
# « Clé secrète de l'app » Meta : sert à vérifier la signature des webhooks
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_LANG=fr
# Noms des modèles de messages approuvés (voir README)
WA_TPL_ADMIN_ALERT=studio_alerte_admin
WA_TPL_CLIENT_UPDATE=studio_info_client
WA_TPL_REMINDER=studio_rappel_session
WA_TPL_PAYMENT_LINK=studio_lien_paiement

# --- Tâches planifiées ---
# Le planificateur tourne dans le processus (toutes les minutes).
# Si l'hébergeur met l'application en veille, désactiver et appeler POST /cron/tick
# chaque minute avec l'en-tête X-Cron-Secret.
SCHEDULER_ENABLED=true
CRON_SECRET=

# Dossier des images importées (doit être persistant)
UPLOAD_DIR=uploads

# --- Notifications push (application installée : téléphone / ordinateur) ---
# Générer une paire de clés : npx web-push generate-vapid-keys
# Facultatif : sans ces clés, le serveur les génère au premier démarrage et les conserve en base.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@westafrecords.com
